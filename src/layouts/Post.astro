---
import type { CollectionEntry } from "astro:content";
import Breadcrumb from "~/components/Breadcrumb.astro";
import Icon from "~/components/Icon.astro";
import Card from "./Card.astro";
import "./Post.css";

type Props = CollectionEntry<"blog">["data"] & {
	slug: CollectionEntry<"blog">["slug"];
};
const { date, icons, slug, title } = Astro.props;

type ICON_NAME = CollectionEntry<"blog">["data"]["icons"][number];
export const ICON_TO_LABEL: Record<ICON_NAME, string> = {
	"ph/bug-duotone": "Bug Fix",
	"ph/gear-fine-duotone": "JS Framework",
	"ph/laptop-duotone": "Computer",
	"ph/list-numbers-duotone": "Tutorial",
	"ph/pencil-circle-duotone": "Personal"
};

const crumbs = [
	{ href: "/", icon: "ph/house-duotone", label: "Home" },
	{ href: "/blog", icon: "ph/newspaper-clipping-duotone", label: "Blog" }
];
---

<Card size="large">
	<header class="space-y-3 pb-3 font-semibold">
		<div class="flex items-start justify-between">
			<div class="basis-2/3 md:basis-1/2">
				<h1
					class="transform-gpu text-3xl font-extrabold tracking-tight"
					data-transition-name={`blog-title-${slug}`}
					transition:name={`blog-title-${slug}`}
				>
					{title}
				</h1>
				<time
					class="transform-gpu text-sm tracking-wide"
					data-transition-name={`blog-date-${slug}`}
					datetime={date.toISOString().split("T")[0]}
					transition:name={`blog-date-${slug}`}
				>
					Written on {date.toLocaleDateString()}
				</time>
			</div>

			<Breadcrumb crumbs={crumbs} />
		</div>

		<h2
			class="inline-flex transform-gpu flex-wrap items-center gap-5 rounded-xl border border-black/20 bg-white/80 px-2 py-1 dark:border-white/30 dark:bg-black/50"
			data-transition-name={`blog-tags-${slug}`}
			transition:name={`blog-tags-${slug}`}
		>
			{
				icons.map((icon) => (
					<div class="inline-flex items-center gap-1">
						<Icon class="size-8" name={icon} />
						<span>{ICON_TO_LABEL[icon]}</span>
					</div>
				))
			}
		</h2>
	</header>

	<main class="post">
		<article>
			<slot />
		</article>
	</main>
</Card>
