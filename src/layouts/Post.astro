---
import type { CollectionEntry } from "astro:content";
import { AstroSeo } from "@astrolib/seo";
import Breadcrumb from "~/components/Breadcrumb.astro";
import Icon from "~/components/Icon.astro";
import Card from "./Card.astro";
import "./Post.css";

type Props = CollectionEntry<"blog">["data"] & {
	slug: CollectionEntry<"blog">["slug"];
};
const props = Astro.props;

type ICON_NAME = CollectionEntry<"blog">["data"]["icons"][number];
export const ICON_TO_LABEL: Record<ICON_NAME, string> = {
	"ph--bug-duotone": "Bug Fix",
	"ph--gear-fine-duotone": "JS Framework",
	"ph--laptop-duotone": "Computer",
	"ph--list-numbers-duotone": "Tutorial",
	"ph--pencil-circle-duotone": "Personal"
};

const crumbs = [
	{ href: "/", icon: "ph--house-duotone", label: "Home" },
	{ href: "/blog", icon: "ph--newspaper-clipping-duotone", label: "Blog" }
];
---

<AstroSeo
	additionalLinkTags={[
		{
			href: `https://raey.me/`,
			rel: "author"
		},
		{
			href: `https://raey.me/blog/${props.slug}`,
			rel: "canonical"
		}
	]}
	additionalMetaTags={[
		{
			content: props.icons.map((icon) => ICON_TO_LABEL[icon]).join(", "),
			name: "keywords"
		}
	]}
	description={props.description}
	openGraph={{
		article: {
			authors: ["Austin Raey"],
			publishedTime: props.date.toISOString().split("T")[0],
			section: "Blog",
			tags: props.icons.map((icon) => ICON_TO_LABEL[icon])
		},
		description: props.description,
		site_name: "Austin's Blog",
		title: props.title,
		type: "article",
		url: `https://raey.me/blog/${props.slug}`
	}}
	title={props.title}
/>

<Card size="large">
	<header class="space-y-3 pb-3 font-semibold">
		<div class="flex items-start justify-between">
			<div class="basis-2/3 md:basis-1/2">
				<h1
					class="transform-gpu text-3xl font-extrabold tracking-tight"
					data-transition-name={`blog-title-${props.slug}`}
					transition:name={`blog-title-${props.slug}`}
				>
					{props.title}
				</h1>
				<time
					class="transform-gpu text-sm tracking-wide"
					data-transition-name={`blog-date-${props.slug}`}
					datetime={props.date.toISOString().split("T")[0]}
					transition:name={`blog-date-${props.slug}`}
				>
					Written on {
						props.date.toLocaleDateString("en-US", {
							day: "numeric",
							month: "long",
							year: "numeric"
						})
					}
				</time>
			</div>

			<Breadcrumb crumbs={crumbs} />
		</div>

		<h2
			class="inline-flex transform-gpu flex-wrap items-center gap-5 rounded-xl border border-black/20 bg-white/80 px-2 py-1 dark:border-white/30 dark:bg-black/50"
			data-transition-name={`blog-tags-${props.slug}`}
			transition:name={`blog-tags-${props.slug}`}
		>
			{
				props.icons.map((icon) => (
					<div class="inline-flex items-center gap-1">
						<Icon class="size-8" name={icon} />
						<span>{ICON_TO_LABEL[icon]}</span>
					</div>
				))
			}
		</h2>
	</header>

	<main class="post">
		<article>
			<slot />
		</article>
	</main>
</Card>
