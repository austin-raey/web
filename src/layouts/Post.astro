---
import Card from "~/components/Card.astro";
import Icon from "~/components/Icon.astro";

import Default from "./Default.astro";

const { frontmatter, url } = Astro.props;
const iconToLabel = {
	"ph/bug-duotone": "Fix",
	"ph/laptop-duotone": "Computer",
	"ph/list-numbers-duotone": "Tutorial",
	"ph/pencil-circle-duotone": "Personal"
};
---

<Default>
	<Card
		class="h-full min-w-[320px] space-y-3 overflow-y-scroll bg-white/50"
		size="large"
	>
		<header class="flex items-start justify-between font-semibold">
			<div class="space-y-2" transition:name={`blog-tags-${url}`}>
				<h1
					class="text-3xl font-extrabold"
					transition:name={`blog-title-${url}`}
				>
					{frontmatter.title}
				</h1>
				<h2 class="flex gap-5 rounded-xl bg-white/80 px-2 py-1">
					{
						frontmatter.icons.map((icon) => (
							<div class="flex items-center gap-2">
								<Icon class="size-8" name={icon} />
								<span>{iconToLabel[icon]}</span>
							</div>
						))
					}
				</h2>
			</div>

			<nav>
				<ol
					class="flex rounded-xl border border-black/20 bg-white/20 px-2 py-1"
					transition:name="breadcrumb"
				>
					<li
						class="flex items-center"
						transition:animate="slide"
						transition:name="breadcrumb-home"
					>
						<a href="/">
							<Icon name="ph/house-duotone" />
							<span class="sr-only">Back to</span> Home
						</a>
						<Icon
							class="mx-1 size-3 opacity-50"
							name="ph/caret-right-duotone"
						/>
					</li>
					<li class="flex items-center">
						<a href="/blog">
							<Icon name="ph/newspaper-clipping-duotone" />
							<span class="sr-only">Back to</span> Blog
						</a>
					</li>
				</ol>
			</nav>
		</header>

		<main transition:name={`blog-content-${url}`}>
			<slot />
		</main>
	</Card>
</Default>
