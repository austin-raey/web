---
import { Image } from "astro:assets";
import IconArrowsClockwiseDuotone from "~icons/ph/arrows-clockwise-duotone";

import LayoutGlobal from "~/layouts/global/layout.astro";
export interface Props {
	size?: "default" | "large";
}

const { size = "default" } = Astro.props;
const isLarge = size === "large";
---

<LayoutGlobal>
	<slot name="seo" slot="seo" />

	<astro-card
		data-motion="true"
		data-size={size}
		transition:animate="initial"
		transition:name="card"
	>
		<div class="controls">
			<button type="button">
				<IconArrowsClockwiseDuotone />
				<span data-motion="false">Disable Motion</span>
				<span data-motion="true">Enable Motion</span>
			</button>
		</div>

		<div class="rotate">
			<div aria-hidden="true" class="shine overlay"></div>
			{
				!isLarge && (
					<Image
						alt=""
						aria-hidden="true"
						class="texture overlay"
						decoding="async"
						fetchpriority="low"
						height="643"
						loading="lazy"
						src="/assets/texture.avif"
						width="1024"
					/>
				)
			}

			<Image
				alt=""
				aria-hidden="true"
				class="bg overlay"
				decoding="async"
				fetchpriority="high"
				height="643"
				loading="eager"
				src="/assets/bg.avif"
				width="1024"
			/>

			<div class="content">
				<slot />
			</div>
		</div>
	</astro-card>
</LayoutGlobal>

{
	/*
NOTE / Observations on includes for scripts and styles:

For page scripts (non-exhaustively):
	- You can import via the `src` attribute of the `<script>` tag, or
	- import them via an import statement in the body of the `<script>` tag, like below, or
	- simply write the script direclty in the body of the `<script>` tag below.

For styles (non-exhaustively):
	- You can import them via Astro's "Component Script" (between the `---` lines),
	- or you can import them directly in the `<style>` tag using `@import`,
	- or you can write the styles directly in the `<style>` tag below.

Especially for *styles*, some of Astro's built-in scoping features are lost when importing
via the Component Script - so it is done below for a more predictable experience.

This does mean that in these style files, `:global` may be necessary for some styling needs.
*/
}

<script>
	const LARGE_CARD_ATTR = "data-has-large-card";
	const MOTION_STORAGE_KEY = "astro-motion";
	const MOTION_HANDLER_KEY = "__astroCardMotionHandlerRegistered";
	const CARD_LAYOUT_HANDLER_KEY = "__astroCardLayoutHandlerRegistered";
	const runtimeState = globalThis as Record<string, boolean> &
	typeof globalThis;

	function initializeCardLayout() {
	const hasLargeCard =
		document.querySelector('astro-card[data-size="large"]') !== null;

	document.documentElement.toggleAttribute(LARGE_CARD_ATTR, hasLargeCard);
	document.body?.toggleAttribute(LARGE_CARD_ATTR, hasLargeCard);
}

function initializeMotion() {
	const storage = globalThis.localStorage.getItem(MOTION_STORAGE_KEY);
	const value = storage === "true" || storage === null;
	for (const card of document.querySelectorAll<HTMLElement>("astro-card")) {
		card.dataset.motion = value.toString();
	}
}

	initializeMotion();
	initializeCardLayout();

	if (!runtimeState[MOTION_HANDLER_KEY]) {
		runtimeState[MOTION_HANDLER_KEY] = true;
		document.addEventListener("astro:after-swap", initializeMotion);
	}

	if (!runtimeState[CARD_LAYOUT_HANDLER_KEY]) {
		runtimeState[CARD_LAYOUT_HANDLER_KEY] = true;
		document.addEventListener("astro:after-swap", initializeCardLayout);
	}
</script>

<script>
	import "./js";
</script>

<style>
	@import "./styles/reset.css";
	@import "./styles/layout.css";
	@import "./styles/controls.css";
</style>
