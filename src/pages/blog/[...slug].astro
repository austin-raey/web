---
import { AstroSeo } from "@astrolib/seo";
import { getCollection, render } from "astro:content";
import IconHouseDuotone from "~icons/ph/house-duotone";
import IconNewsPaperClipping from "~icons/ph/newspaper-clipping-duotone";

import Breadcrumbs from "~/components/breadcrumbs.astro";
import Card from "~/layouts/card/layout.astro";

import KindToIcon, { KIND_TO_LABEL } from "./_/components/kind-to-icon.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post }
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const CRUMBS = [
	{ href: "/", icon: IconHouseDuotone, label: "Home" },
	{ href: "/blog", icon: IconNewsPaperClipping, label: "Blog" },
	{ href: `/blog/${post.id}`, label: post.data.title }
];
---

<Card size="large">
	<AstroSeo
		additionalMetaTags={[
			{
				content: "Austin Raey",
				name: "author"
			},
			{
				content: post.data.kind.join(", "),
				name: "keywords"
			}
		]}
		canonical={new URL(Astro.url, Astro.site).toString()}
		description={post.data.description}
		openGraph={{
			article: {
				authors: ["Austin Raey"],
				publishedTime: post.data.date.toISOString(),
				tags: post.data.kind
			},
			description: post.data.description,
			site_name: "Austin Raey",
			title: post.data.title,
			type: "article",
			url: Astro.url.toString()
		}}
		slot="seo"
		title={` Austin Raey's blog | ${post.data.title}`}
	/>

	<header>
		<div>
			<div>
				<h1 transition:name={`blog-title-${post.id}`}>
					{post.data.title}
				</h1>
				<time
					datetime={post.data.date.toISOString().split("T")[0]}
					transition:name={`blog-time-${post.id}`}
				>
					Written on {
						post.data.date.toLocaleDateString("en-US", {
							day: "numeric",
							month: "long",
							year: "numeric"
						})
					}
				</time>
			</div>

			<h3 transition:name={`blog-tags-${post.id}`}>
				{
					post.data.kind.map((kind) => (
						<span>
							<KindToIcon {kind} />
							{KIND_TO_LABEL[kind]}
						</span>
					))
				}
			</h3>
		</div>

		<Breadcrumbs crumbs={CRUMBS} />
	</header>

	<main class="post">
		<article>
			<Content />
		</article>
	</main>
</Card>

<style>
	header {
		display: flex;
		justify-content: space-between;
		gap: 2rem;
	}

	@media screen and (max-width: 768px) {
		header {
			flex-direction: column;
			gap: 1rem;

			> div {
				order: 1;
			}
		}
	}

	time {
		font-size: 0.875rem;
		font-weight: 500;
		margin-top: var(--spacing-xs);
	}

	h3 {
		display: flex;
		gap: 1rem;
		margin-top: 1rem;

		span {
			align-items: center;
			display: flex;
			gap: var(--spacing-xs);
		}

		svg {
			width: 2rem;
			height: 2rem;
		}
	}

	article {
		padding-bottom: 3rem;
	}

	/* TODO: Move these into a seperate file */
	:global(.post) {
		.tags {
			margin: 1rem 0;
			font-size: 0.875rem;

			ul {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
		}

		a {
			color: var(--color-link);
			font-weight: 600;
			text-decoration: underline;
			transition: color 0.2s ease-in-out;
			text-underline-offset: 0.125rem;
			text-decoration-thickness: 2px;
		}

		p > code {
			background-color: oklch(100% 0 0 / 0.25);
			padding: 0.125rem var(--spacing-xs);
			font-family: monospace;
			font-size: 0.875em;
			border: 0.5px solid oklch(100% 0 0 / 1);
			border-radius: 0.5em;
		}

		section:not([class]) {
			margin: 2.5rem 0;
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}

		pre {
			background: linear-gradient(
				135deg,
				oklch(100% 0 0 / 0.75),
				oklch(100% 0 0 / 0.55)
			) !important;
			backdrop-filter: blur(10px) saturate(200%) hue-rotate(30deg);
			border: 1px solid oklch(0 0 0 / 0.1);
			border-radius: 0.5rem;
			padding: 0.5rem;
			scrollbar-color: #fffa transparent;
			max-width: max-content;
			max-height: 30ch;

			span {
				text-shadow: none;
			}
		}

		ol {
			list-style: decimal;
			margin-left: 1.5rem;

			> li {
				margin-bottom: 0.5rem;
			}
		}
	}
</style>
