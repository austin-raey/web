---
import { AstroSeo } from "@astrolib/seo";
import { getCollection, render } from "astro:content";
import IconHouseDuotone from "~icons/ph/house-duotone";
import IconNewsPaperClipping from "~icons/ph/newspaper-clipping-duotone";

import Breadcrumbs from "~/components/breadcrumbs.astro";
import Anchor from "~/components/mdx/anchor.astro";
import CodeBlock from "~/components/mdx/code-block.astro";
import Card from "~/layouts/card/layout.astro";

import KindToIcon, { KIND_TO_LABEL } from "./_/components/kind-to-icon.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post }
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const CRUMBS = [
	{ href: "/", icon: IconHouseDuotone, label: "Home" },
	{ href: "/blog", icon: IconNewsPaperClipping, label: "Blog" },
	{ href: `/blog/${post.id}`, label: post.data.title }
];
---

<Card size="large">
	<AstroSeo
		additionalMetaTags={[
			{
				content: "Austin Raey",
				name: "author"
			},
			{
				content: post.data.kind.join(", "),
				name: "keywords"
			}
		]}
		canonical={new URL(Astro.url, Astro.site).toString()}
		description={post.data.description}
		openGraph={{
			article: {
				authors: ["Austin Raey"],
				publishedTime: post.data.date.toISOString(),
				tags: post.data.kind
			},
			description: post.data.description,
			site_name: "Austin Raey",
			title: post.data.title,
			type: "article",
			url: Astro.url.toString()
		}}
		slot="seo"
		title={` Austin Raey's blog | ${post.data.title}`}
	/>

	<header>
		<div>
			<div>
				<h1
					aria-labelledby="post-title"
					transition:name={`blog-title-${post.id}`}
				>
					{post.data.title}
				</h1>
				<time
					datetime={post.data.date.toISOString().split("T")[0]}
					transition:name={`blog-time-${post.id}`}
				>
					Written on {
						post.data.date.toLocaleDateString("en-US", {
							day: "numeric",
							month: "long",
							year: "numeric"
						})
					}
				</time>
			</div>

			<h2
				class="labels"
				id="post-labels"
				transition:name={`blog-tags-${post.id}`}
			>
				{
					post.data.kind.map((kind) => (
						<span>
							<KindToIcon {kind} />
							{KIND_TO_LABEL[kind]}
						</span>
					))
				}
			</h2>
		</div>

		<Breadcrumbs crumbs={CRUMBS} />
	</header>

	<main class="post">
		<Content components={{ a: Anchor, pre: CodeBlock }} />
	</main>
</Card>

<style>
	header {
		padding-top: var(--size-4);
		display: flex;
		justify-content: space-between;
		gap: 2rem;
	}

	@media screen and (max-width: 768px) {
		header {
			flex-direction: column;
			gap: 1rem;

			> div {
				order: 1;
			}
		}
	}

	time {
		font-size: 0.875rem;
		font-weight: 500;
		margin-top: var(--size-2);
	}

	.labels {
		display: flex;
		gap: 1rem;
		font-size: 1.25rem;
		margin-top: var(--size-4);

		span {
			align-items: center;
			display: flex;
			gap: var(--size-2);
		}

		svg {
			width: 2rem;
			height: 2rem;
		}
	}

	article {
		padding-bottom: var(--size-12);
	}

	/* TODO: Move these into a seperate file */
	.post {
		.tags {
			margin: 1rem 0;
			font-size: 0.875rem;

			ul {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
		}

		p > code {
			background-color: oklch(100% 0 0 / 0.25);
			padding: 0.125rem var(--size-2);
			font-family: monospace;
			border: 0.5px solid oklch(100% 0 0 / 1);
			border-radius: 0.5em;
		}

		section:not([class]) {
			margin: var(--size-8) auto;
			display: flex;
			flex-direction: column;
			gap: var(--size-3);
			max-width: 70ch;
		}

		ol {
			list-style: decimal;
			margin-left: var(--size-4);

			> li {
				margin-bottom: 0.5rem;
			}
		}

		ul {
			list-style: disc;
			margin-left: var(--size-4);

			> li {
				margin-bottom: 0.5rem;
			}
		}

		h2:not(.title) {
			font-size: 2rem;
		}

		h3:not(.description) {
			font-size: 1.5rem;
			padding-top: var(--size-2);
		}
	}

	h1 {
		font-size: 2.5rem;
	}
</style>
