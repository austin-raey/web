---
import type { CollectionEntry } from "astro:content";

import Anchor from "~/components/anchor.astro";
import { formatShortDate, toDateOnlyString } from "~/utils/date";

import KindToIcon from "./kind-to-icon.astro";

type Props = CollectionEntry<"blog">;
const { data: { date, description = "", kind, title } = {}, id } = Astro.props;

const href = `/blog/${id}`;
---

<Anchor href={href}>
	<article transition:name={`blog-tags-${id}`}>
		<div aria-describedby="post-title" class="categories">
			<span class="sr-only">Categories:</span>
			<span>{kind?.map((k) => <KindToIcon kind={k} />)}</span>
			<time
				datetime={date ? toDateOnlyString(date) : undefined}
				transition:name={`blog-time-${id}`}
			>
				<span class="sr-only">Written on</span>
				{date ? formatShortDate(date) : undefined}
			</time>
		</div>
		<div id="post-title">
			<h2 class="title" transition:name={`blog-title-${id}`}>
				{title}
			</h2>
			{description !== "" && <h3 class="description">{description}</h3>}
		</div>
	</article>
</Anchor>

<style>
	.title {
		margin-bottom: var(--size-0-5);
		font-size: 1.125rem;
	}

	.description {
		font-size: 0.8rem;
		max-width: 45ch;
		line-height: 1.33;
		font-weight: 500;
		color: oklch(50% 0 0);
	}

	.categories {
		display: flex;
		flex-direction: column;
		font-size: 1rem;
		align-items: center;
		align-self: flex-start;
		gap: var(--size-1) 0;
		flex-shrink: 0;
	}

	article {
		font-size: 0.875em;
		font-weight: 300;
		display: flex;
		align-items: center;
		padding: 0.5rem;
		gap: 1em;
	}

	time {
		font-weight: 600;
		font-size: 0.75em;
		background: linear-gradient(
			135deg,
			oklch(85% 0 0 / 0.25),
			oklch(90% 0 0 / 0.05)
		);
		backdrop-filter: blur(10px) saturate(200%) hue-rotate(30deg);
		border-radius: var(--size-2);
		padding: var(--size-0-5) var(--size-1);
	}

	article :global(svg) {
		width: 2em;
		height: 2em;
	}
</style>
