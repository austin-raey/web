---
import type { CollectionEntry } from "astro:content";

import Anchor from "~/components/anchor.astro";

import KindToIcon from "./kind-to-icon.astro";

type Props = CollectionEntry<"blog">;
const { data: { date, description = "", kind, title } = {}, id } = Astro.props;

const href = `/blog/${id}`;
---

<Anchor href={href}>
	<article transition:name={`blog-tags-${id}`}>
		<div aria-describedby="post-title" class="categories">
			<span class="sr-only">Categories:</span>
			<span>{kind?.map((k) => <KindToIcon kind={k} />)}</span>
			<time
				datetime={date?.toISOString().split("T")[0]}
				transition:name={`blog-time-${id}`}
			>
				<span class="sr-only">Written on</span>
				{date?.toLocaleDateString()}
			</time>
		</div>
		<div id="post-title" transition:name={`blog-title-${id}`}>
			<h2 class="title">
				{title}
			</h2>
			{description !== "" && <h3 class="description">{description}</h3>}
		</div>
	</article>
</Anchor>

<style>
	.title {
		margin-bottom: var(--spacing-xs);
		font-size: 1.25rem;
	}

	.description {
		font-size: 0.75rem;
		letter-spacing: -0.0125rem;
		max-width: 45ch;
		font-weight: 500;
	}

	.categories {
		display: flex;
		flex-direction: column;
		font-size: 1rem;
		align-items: center;
		align-self: flex-start;
		gap: var(--spacing-xxs) 0;
		flex-shrink: 0;
	}

	article {
		font-size: 0.875em;
		font-weight: 300;
		display: flex;
		align-items: center;
		padding: 0.5rem;
		gap: 1em;
		pointer-events: none;
	}

	time {
		font-weight: 300;
		font-size: 0.75em;
		letter-spacing: 0.025em;
	}

	article :global(svg) {
		width: 2em;
		height: 2em;
	}
</style>
