---
import { AstroSeo } from "@astrolib/seo";
import { getCollection } from "astro:content";
import IconNewsPaperClipping from "~icons/ph/newspaper-clipping-duotone";

import LayoutLanding from "~/layouts/landing/layout.astro";

import BlogLink from "./_/components/blog-link.astro";

const collection = await getCollection("blog");
const posts = collection.toSorted(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const CRUMBS = [{ href: "/blog", icon: IconNewsPaperClipping, label: "Blog" }];
---

<LayoutLanding
	crumbs={CRUMBS}
	description="Here I post my thoughts on things, tutorials, and fixes to random nonsense I encounter when using computers (so I don't forget!)."
	title="Blog"
>
	<AstroSeo
		additionalMetaTags={[
			{
				content: "Austin Raey",
				name: "author"
			},
			{
				content:
					"blog, software engineering, frontend, full-stack, devops, javascript, typescript",
				name: "keywords"
			}
		]}
		canonical={new URL(Astro.url, Astro.site).toString()}
		description="Austin's thoughts on software engineering, tutorials, and tech solutions"
		openGraph={{
			description:
				"Austin's thoughts on software engineering, tutorials, and tech solutions",
			site_name: "Austin Raey",
			title: "Austin Raey's blog",
			type: "website",
			url: Astro.url.toString()
		}}
		slot="seo"
		title="Austin Raey's blog"
	/>
	<nav aria-label="Blog posts">
		<ol>
			{
				posts.map((post) => (
					<li>
						<BlogLink {...post} />
					</li>
				))
			}
		</ol>
	</nav>
</LayoutLanding>

<style>
	ol {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(3, 1fr);

		@media screen and (max-width: 1024px) {
			grid-template-columns: repeat(2, 1fr);
		}

		@media screen and (max-width: 640px) {
			gap: var(--spacing-sm);
			grid-template-columns: 1fr;
		}

		li {
			display: flex;
		}

		a {
			flex-grow: 1;
		}
	}
</style>
