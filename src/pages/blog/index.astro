---
import { AstroSeo } from "@astrolib/seo";
import { getCollection } from "astro:content";
import IconHouseDuotone from "~icons/ph/house-duotone";
import IconNewsPaperClipping from "~icons/ph/newspaper-clipping-duotone";

import Breadcrumb from "~/components/breadcrumb.astro";
import Card from "~/layouts/card/layout.astro";

import BlogLink from "./_/components/blog-link.astro";

const collection = await getCollection("blog");
const posts = collection.toSorted(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const CRUMBS = [
	{ href: "/", icon: IconHouseDuotone, label: "Home" },
	{ href: "/blog", icon: IconNewsPaperClipping, label: "Blog" }
];
---

<Card size="large">
	<AstroSeo
		additionalMetaTags={[
			{
				content: "Austin Raey",
				name: "author"
			},
			{
				content:
					"blog, software engineering, frontend, full-stack, devops, javascript, typescript",
				name: "keywords"
			}
		]}
		canonical={new URL(Astro.url, Astro.site).toString()}
		description="Austin Raey's blog - thoughts on software engineering, tutorials, and tech solutions"
		openGraph={{
			description:
				"Austin Raey's blog - thoughts on software engineering, tutorials, and tech solutions",
			site_name: "Austin Raey",
			title: "Blog",
			type: "website",
			url: Astro.url.toString()
		}}
		slot="seo"
		title="Blog"
	/>

	<header>
		<div>
			<h1>Blog</h1>
			<p style="max-width:60ch;">
				Here I post my thoughts on things, tutorials, and fixes to random
				nonsense I encounter when using computers (so I don't forget!).
			</p>
		</div>
		<Breadcrumb crumbs={CRUMBS} />
	</header>
	<main>
		<nav aria-label="Blog posts">
			<ol>
				{
					posts.map((post) => (
						<li>
							<BlogLink {...post} />
						</li>
					))
				}
			</ol>
		</nav>
	</main>
</Card>

<style>
	nav {
		margin-top: 1rem;
	}

	ol {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(3, 1fr);

		@media screen and (max-width: 1024px) {
			grid-template-columns: repeat(2, 1fr);
		}

		@media screen and (max-width: 640px) {
			gap: 0.25rem;
			grid-template-columns: 1fr;
		}

		li {
			display: flex;
		}

		a {
			flex-grow: 1;
		}
	}

	header {
		display: flex;
		justify-content: space-between;
	}
</style>
