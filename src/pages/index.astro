---
import { AstroSeo } from "@astrolib/seo";
import { Image } from "astro:assets";
import IconBlueprint from "~icons/ph/blueprint-duotone";
import IconBookBookmarkDuotone from "~icons/ph/book-bookmark-duotone";
import IconGitHub from "~icons/ph/github-logo-duotone";
import IconInstagram from "~icons/ph/instagram-logo-duotone";
import IconLinkedIn from "~icons/ph/linkedin-logo-duotone";
import IconMapPin from "~icons/ph/map-pin-duotone";
import IconNewsPaperClipping from "~icons/ph/newspaper-clipping-duotone";
import IconShirtFolded from "~icons/ph/shirt-folded-duotone";
import IconThreads from "~icons/ph/threads-logo-duotone";

import Anchor from "~/components/anchor.astro";
import Card from "~/layouts/card/layout.astro";
---

<Card>
	<AstroSeo
		additionalMetaTags={[
			{
				content: "Austin Raey",
				name: "author"
			},
			{
				content: "software engineer, frontend, full-stack, devops",
				name: "keywords"
			}
		]}
		canonical={new URL(Astro.url, Astro.site).toString()}
		description="Austin Raey's contact card"
		openGraph={{
			description: "Austin Raey's contact card",
			images: [
				{
					alt: "Portrait of Austin Raey",
					height: 100,
					url: "/assets/portrait.avif",
					width: 100
				}
			],
			site_name: "Austin Raey",
			title: "Austin Raey",
			type: "profile",
			url: Astro.url.toString()
		}}
		slot="seo"
		title="Austin Raey"
	/>
	<main transition:name="content">
		<article>
			<figure>
				<Image
					alt="Portrait of Austin Raey"
					fetchpriority="high"
					height="100"
					loading="eager"
					src="/assets/portrait.avif"
					width="100"
				/>
				<figcaption>
					<h1>
						<span>Austin</span>
						<span>Raey</span>
					</h1>
				</figcaption>
			</figure>

			<section>
				<p>
					<IconMapPin />
					<span class="sr-only">Located in:</span> North Carolina
				</p>
				<p>
					<IconShirtFolded />
					<span class="sr-only">Occupation:</span> Software Engineer
				</p>
				<dl>
					<dt class="sr-only">Specializing in:</dt>
					<dd>Frontend</dd>
					<dd>Full-Stack</dd>
					<dd>DevOps</dd>
					<dt class="sr-only">Proficient in:</dt>
					<dd>JavaScript</dd>
					<dd>TypeScript</dd>
					<dd>Frameworks</dd>
				</dl>
			</section>

			<footer>
				<nav aria-labelledby="socials">
					<h2 class="sr-only" id="socials">Socials</h2>
					<Anchor
						href="https://github.com/austin-raey"
						rel="me external noopener noreferrer"
						target="_blank"
						title="Austin's GitHub profile"
					>
						<IconGitHub aria-hidden="true" /> austin-raey
					</Anchor>
					<Anchor
						href="https://www.threads.net/@austin.raey"
						rel="me external noopener noreferrer"
						target="_blank"
						title="Austin's Threads profile"
					>
						<IconThreads aria-hidden="true" /> austin.raey
					</Anchor>
					<Anchor
						href="https://www.instagram.com/austin.raey"
						rel="me external noopener noreferrer"
						target="_blank"
						title="Austin's Instagram profile"
					>
						<IconInstagram aria-hidden="true" /> austin.raey
					</Anchor>
					<Anchor
						href="https://www.linkedin.com/in/austin-raey/"
						rel="me external noopener noreferrer"
						target="_blank"
						title="Austin's LinkedIn profile"
					>
						<IconLinkedIn aria-hidden="true" /> austin-raey
					</Anchor>
				</nav>
				<nav aria-labelledby="links" transition:name="breadcrumb">
					<h2 class="sr-only" id="links">Links</h2>
					<Anchor
						href="/blog"
						prefetch
						priority="high"
						rel="me"
						title="Austin's blog"
					>
						<IconNewsPaperClipping aria-hidden="true" />
						Blog
					</Anchor>
					<Anchor
						href="/projects"
						prefetch
						priority="high"
						rel="me"
						title="Austin's personal projects"
					>
						<IconBlueprint aria-hidden="true" />
						Projects
					</Anchor>
					<Anchor
						href="/bookmarks"
						prefetch
						priority="high"
						rel="me"
						title="Links I think are cool"
					>
						<IconBookBookmarkDuotone aria-hidden="true" />
						Bookmarks
					</Anchor>
				</nav>
			</footer>
		</article>
	</main>
</Card>

<style>
	footer {
		display: flex;
		flex-direction: column;
		gap: var(--size-1);
	}

	dl {
		display: flex;
		flex-wrap: wrap;
		gap: var(--size-1);
		margin-left: var(--size-5);
		max-width: 33ch;
	}

	dd {
		border-radius: var(--size-1);
		background: oklch(100% 0 0 / 0.25);
		border: 0.5px solid color-mix(in srgb, currentColor 20%, transparent);
		font-size: var(--size-3);
		font-weight: 500;
		letter-spacing: var(--size-0-125);
		line-height: 1.1;
		padding: var(--size-1);
		position: relative;
	}

	section {
		display: flex;
		flex-direction: column;
		gap: var(--size-1);
		margin: var(--size-3) 0;

		p {
			font-weight: 600;
		}
	}

	nav,
	ul {
		display: flex;
		gap: var(--size-1);
	}

	img {
		border-radius: 33%;
		position: absolute;
		right: 0;
		top: 0;
		margin: var(--size-4);
		border-top: 3px solid oklch(100% 0 0 / 0.75);
		border-right: 3px solid oklch(90% 0 0 / 0.75);
		border-bottom: 3px solid oklch(85% 0 0 / 0.75);
		border-left: 3px solid oklch(90% 0 0 / 0.75);
		opacity: 0.9;
	}

	h1 {
		span {
			display: block;
			font-size: 2.25rem;
			line-height: 0.9;
		}

		> :last-child {
			font-weight: 900;
			font-size: 3rem;
		}
	}

	a {
		font-size: 0.875rem;
	}
</style>
