---
import { AstroSeo } from "@astrolib/seo";
import { Image } from "astro:assets";
import IconBlueprint from "~icons/ph/blueprint-duotone";
import IconGitHub from "~icons/ph/github-logo-duotone";
import IconInstagram from "~icons/ph/instagram-logo-duotone";
import IconLinkedIn from "~icons/ph/linkedin-logo-duotone";
import IconMapPin from "~icons/ph/map-pin-duotone";
import IconNewsPaperClipping from "~icons/ph/newspaper-clipping-duotone";
import IconShirtFolded from "~icons/ph/shirt-folded-duotone";
import IconThreads from "~icons/ph/threads-logo-duotone";

import Link from "~/components/link.astro";
import Card from "~/layouts/card/layout.astro";
---

<Card>
	<AstroSeo
		additionalMetaTags={[
			{
				content: "Austin Raey",
				name: "author"
			}
		]}
		canonical={new URL(Astro.url, Astro.site).toString()}
		description="Austin Raey’s contact card"
		openGraph={{
			description: "Austin Raey’s contact card",
			images: [
				{
					alt: "Portrait of Austin Raey",
					height: 100,
					url: "/assets/portrait.avif",
					width: 100
				}
			],
			site_name: "Austin Raey",
			title: "Austin Raey",
			type: "profile",
			url: Astro.url.toString()
		}}
		slot="seo"
		title="Austin Raey"
	/>
	<main>
		<article>
			<figure>
				<Image
					alt="Portrait of Austin Raey"
					fetchpriority="high"
					height="100"
					loading="eager"
					src="/assets/portrait.avif"
					width="100"
				/>
				<figcaption>
					<h1>
						<span>Austin</span>
						<span>Raey</span>
					</h1>
				</figcaption>
			</figure>

			<section>
				<p>
					<IconMapPin />
					<span class="sr-only">Located in:</span> North Carolina
				</p>
				<p>
					<IconShirtFolded />
					<span class="sr-only">Occupation:</span> Software Engineer
				</p>
				<dl>
					<dt class="sr-only">Specializing in:</dt>
					<dd>Frontend</dd>
					<dd>Full-Stack</dd>
					<dd>DevOps</dd>
					<dt class="sr-only">Proficient in:</dt>
					<dd>JavaScript</dd>
					<dd>TypeScript</dd>
					<dd>Frameworks</dd>
				</dl>
			</section>

			<footer>
				<nav aria-labelledby="socials">
					<h3 class="sr-only" id="socials">Socials</h3>
					<Link
						href="https://github.com/austin-raey"
						rel="me external noopener noreferrer"
						target="_blank"
						title="Austin's GitHub profile"
						variant="button"
					>
						<IconGitHub /> austin-raey
					</Link>
					<Link
						href="https://www.threads.net/@austin.raey"
						rel="me external noopener noreferrer"
						target="_blank"
						title="Austin's Threads profile"
						variant="button"
					>
						<IconThreads /> austin.raey
					</Link>
					<Link
						href="https://www.instagram.com/austin.raey"
						rel="me external noopener noreferrer"
						target="_blank"
						title="Austin's Instagram profile"
						variant="button"
					>
						<IconInstagram /> austin.raey
					</Link>
					<Link
						href="https://www.linkedin.com/in/austin-raey/"
						rel="me external noopener noreferrer"
						target="_blank"
						title="Austin's LinkedIn profile"
						variant="button"
					>
						<IconLinkedIn /> austin-raey
					</Link>
				</nav>
				<nav aria-labelledby="links">
					<h3 class="sr-only" id="links">Links</h3>
					<Link
						href="/blog"
						priority="high"
						rel="me"
						title="Austin's blog"
						variant="button"
					>
						<IconNewsPaperClipping />
						Blog
					</Link>
					<Link
						href="/projects"
						priority="high"
						rel="me"
						title="Austin's personal projects"
						variant="button"
					>
						<IconBlueprint />
						Projects
					</Link>
				</nav>
			</footer>
		</article>
	</main>
</Card>

<style>
	footer {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	dl {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin-left: 1.2rem;
		max-width: 33ch;
	}

	dd {
		border-radius: 0.3rem;
		border: 0.5px solid color-mix(in srgb, currentColor 20%, transparent);
		color: #222d;
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.0125rem;
		line-height: 1.1;
		padding: 0.15rem 0.3rem;
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 1rem 0;

		p {
			font-weight: 600;
		}
	}

	nav,
	ul {
		display: flex;
		gap: 0.25rem;
	}

	img {
		border-radius: 33%;
		position: absolute;
		right: 0;
		top: 0;
		margin: 1rem;
		border-top: 3px solid #fff9;
		border-right: 3px solid #ddd9;
		border-bottom: 3px solid #ccc9;
		border-left: 3px solid #ddd9;
		opacity: 0.95;
	}

	h1 {
		span {
			display: block;
			font-size: 2.25rem;
			line-height: 0.9;
		}

		> :last-child {
			font-weight: 900;
			font-size: 3rem;
		}
	}
</style>
