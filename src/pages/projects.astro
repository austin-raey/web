---
import { AstroSeo } from "@astrolib/seo";
import IconBun from "~icons/logos/bun";
import IconNextjs from "~icons/logos/nextjs-icon";
import IconBlueprint from "~icons/ph/blueprint-duotone";
import IconLaptop from "~icons/ph/laptop-duotone";
import IconPackage from "~icons/ph/package-duotone";
import IconTerminal from "~icons/ph/terminal-duotone";

import RichAnchor from "~/components/rich-anchor.astro";
import Layout from "~/layouts/landing/layout.astro";
import { splitAlternating } from "~/utils/layout";

const CRUMBS = [{ href: "/projects", icon: IconBlueprint, label: "Projects" }];

const links = [
	{
		description: "My personal dotfiles for macOS and Windows",
		href: "https://github.com/austin-raey/dotfiles",
		icons: [
			{ icon: IconLaptop, title: "Relates to Computers" },
			{ icon: IconTerminal, title: "Relates to Dotfiles" }
		],
		title: "Dotfiles"
	},
	{
		description:
			"A lightweight bun-based package upgrade tool that updates dependencies to their latest version",
		href: "https://github.com/austin-raey/bskt",
		icons: [
			{ icon: IconBun, title: "Relates to Bun" },
			{ icon: IconPackage, title: "Relates to Package Management" }
		],
		title: "bskt"
	},
	{
		description:
			"A minimal, enterprise-ready Next.js starter template with batteries included",
		href: "https://github.com/austin-raey/before.tmp",
		icons: [
			{ icon: IconNextjs, title: "Relates to Next.js" },
			{ icon: IconBlueprint, title: "Starter Template" }
		],
		title: "Before.tmp"
	}
];

const columns = splitAlternating(links, 2);
---

<Layout
	crumbs={CRUMBS}
	description="Listed are some personal projects I've created for fun or for personal use."
	title="Projects"
>
	<AstroSeo
		additionalMetaTags={[
			{
				content: "Austin Raey",
				name: "author"
			},
			{
				content:
					"projects, software engineering, frontend, full-stack, devops, computer",
				name: "keywords"
			}
		]}
		canonical={new URL(Astro.url, Astro.site).toString()}
		description="Austin's personal projects related to software engineering, frontend, full-stack, devops, and computers"
		openGraph={{
			description:
				"Austin's personal projects related to software engineering, frontend, full-stack, devops, and computers",
			site_name: "Austin Raey",
			title: "Austin Raey's projects",
			type: "website",
			url: Astro.url.toString()
		}}
		slot="seo"
		title="Austin Raey's projects"
	/>

	<nav>
		{
			columns.map((column) => (
				<div>
					{column.map((link) => (
						<RichAnchor {...link} rel="me external noopener noreferrer" />
					))}
				</div>
			))
		}
	</nav>
</Layout>

<style>
	nav {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.5rem;
		max-width: 60ch;

		> div {
			display: grid;
			grid-template-rows: max-content;
			gap: 0.5rem;
		}

		@media screen and (max-width: 640px) {
			grid-template-columns: 1fr;
		}
	}
</style>
