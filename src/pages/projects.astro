---
import Breadcrumb from "~/components/Breadcrumb.astro";
import ProjectLink, {
	type Props as ProjectLinkProps
} from "~/components/project-link.astro";
import ContactCard from "~/layouts/contact-card.astro";

const crumbs = [{ href: "/", icon: "ph--house-duotone", label: "Home" }];
const links: ProjectLinkProps[] = [
	{
		description: "My personal dotfiles for macOS and Windows",
		href: "https://github.com/austin-raey/dotfiles",
		icons: [
			{ name: "ph--laptop-duotone", title: "Computer" },
			{ name: "ph--terminal-duotone", title: "Dotfiles" }
		],
		title: "Dotfiles"
	},
	{
		description:
			"A lightweight bun-based package upgrade tool that updates dependencies to their latest version",
		href: "https://github.com/austin-raey/bskt",
		icons: [
			{ name: "logos--bun", title: "Bun" },
			{ name: "ph--package-duotone", title: "Package Management" }
		],
		title: "bskt"
	},
	{
		description:
			"A minimal, enterprise-ready Next.js starter template with batteries included",
		href: "https://github.com/austin-raey/before.tmp",
		icons: [
			{ name: "logos--nextjs-icon", title: "Next.js" },
			{ name: "ph--newspaper-duotone", title: "Starter Template" }
		],
		title: "Before.tmp"
	}
];
---

<ContactCard size="large">
	<header class="space-y-3">
		<div class="flex items-start justify-between">
			<h1 class="text-3xl font-extrabold">Projects</h1>
			<Breadcrumb crumbs={crumbs} />
		</div>
		<p>
			Listed are some personal projects I've created for fun or for personal
			use.
		</p>
	</header>

	<main>
		<menu class="grid max-w-lg grid-cols-2 gap-2">
			<div class="grid grid-rows-[max-content] gap-2">
				{
					links
						.filter((_, index) => index % 2 === 0)
						.map((link) => (
							<li>
								<ProjectLink {...link} />
							</li>
						))
				}
			</div>
			<div class="grid grid-rows-[max-content] gap-2">
				{
					links
						.filter((_, index) => index % 2 === 1)
						.map((link) => (
							<li>
								<ProjectLink {...link} />
							</li>
						))
				}
			</div>
		</menu>
	</main>
</ContactCard>
