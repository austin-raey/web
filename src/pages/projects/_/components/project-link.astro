---
import type { JSX } from "astro/jsx-runtime";

import Link from "~/components/link.astro";

export interface Props {
	description?: string;
	href: string;
	icons: { icon: JSX.Element; title: string }[];
	title: string;
}
const { description = "", href, icons = [], title } = Astro.props;
---

<Link
	href={href}
	rel="me external noopener noreferrer"
	target="_blank"
	variant="button"
>
	<article>
		<h3>
			<span class="sr-only">Project relates to:</span>
			{
				icons.map((icon) => (
					<span title={icon.title}>
						<icon.icon />
					</span>
				))
			}
		</h3>

		<div>
			<h2>
				{title}
			</h2>
			<h4>{description}</h4>
		</div>
	</article>
</Link>

<style>
	article {
		display: flex;
		gap: 0.5rem;
		padding: 0.5rem;
	}

	h2,
	h3 {
		line-height: 1;
	}

	h3 {
		display: flex;
		flex-shrink: 0;
		flex-grow: 1;
		gap: 0.5rem;
	}

	article :global(svg) {
		width: 2rem;
		height: 2rem;
	}
</style>
