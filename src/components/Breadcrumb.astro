---
import Icon from "./Icon.astro";
interface Props {
	crumbs: { href: string; icon: string; label: string }[];
}
const { crumbs = [] } = Astro.props;
---

<nav class="font-semibold">
	<ol
		class="flex flex-col flex-wrap rounded-xl border border-black/20 bg-white/20 px-2 py-1 sm:flex-row"
		data-transition-name="breadcrumb"
		transition:name="breadcrumb"
	>
		{
			crumbs.map((crumb) => (
				<li
					data-transition-name={`breadcrumb-${crumb.href}`}
					transition:name={`breadcrumb-${crumb.href}`}
				>
					<a href={crumb.href}>
						<Icon name={crumb.icon} /> {crumb.label}
					</a>
					{crumbs.at(-1) !== crumb && (
						<Icon class="sm:mr-1" name="ph/caret-right-duotone" />
					)}
				</li>
			))
		}
	</ol>
</nav>
