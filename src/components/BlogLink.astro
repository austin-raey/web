---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";

type Props = CollectionEntry<"blog">;
const { data: { date, icons = [], shortDescription = "", title } = {}, slug } =
	Astro.props;

const href = `/blog/${slug}`;
---

<a class="block rounded-xl py-3" href={href}>
	<div class="flex items-start space-x-2">
		<div
			class="h-full shrink rounded-xl bg-white/80 px-2 py-1 text-center"
			data-transition-name={`blog-tags-${slug}`}
			transition:name={`blog-tags-${slug}`}
		>
			<h3 class="flex max-w-max shrink gap-1">
				{icons.map((icon) => <Icon class="size-8" name={icon} />)}
			</h3>
			<time
				class="text-xs tracking-wider"
				data-transition-name={`blog-date-${slug}`}
				datetime={date?.toISOString().split("T")[0]}
				transition:name={`blog-date-${slug}`}
			>
				<span class="sr-only">Written on</span>
				{date?.toLocaleDateString()}
			</time>
		</div>

		<div class="space-y-0">
			<h2
				class="text-xl font-bold leading-none"
				data-transition-name={`blog-title-${slug}`}
				transition:name={`blog-title-${slug}`}
			>
				{title}
			</h2>
			{shortDescription !== "" && <p class="opacity-75">{shortDescription}</p>}
		</div>
	</div>
</a>
