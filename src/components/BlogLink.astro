---
import type { CollectionEntry } from "astro:content";
import { ICON_TO_LABEL } from "~/layouts/Post.astro";
import Icon from "./Icon.astro";

type Props = CollectionEntry<"blog">;
const { data: { date, description = "", icons = [], title } = {}, slug } =
	Astro.props;

const href = `/blog/${slug}`;
---

<a
	class="block transform-gpu rounded-xl border border-black/20 bg-white/80 p-3 px-2 dark:border-white/30 dark:bg-black/50"
	data-transition-name={`blog-tags-${slug}`}
	href={href}
	transition:name={`blog-tags-${slug}`}
>
	<article class="flex items-start gap-2">
		<div class="shrink px-2 py-1 text-center">
			<h3>
				<span class="sr-only">Categories:</span>
				{
					icons.map((icon) => (
						<Icon class="size-8" name={icon} title={ICON_TO_LABEL[icon]} />
					))
				}
			</h3>
			<time
				class="transform-gpu text-xs tracking-wider"
				data-transition-name={`blog-date-${slug}`}
				datetime={date?.toISOString().split("T")[0]}
				transition:name={`blog-date-${slug}`}
			>
				<span class="sr-only">Written on</span>
				{date?.toLocaleDateString()}
			</time>
		</div>

		<div class="space-y-0.5">
			<h2
				class="text-xl font-bold leading-none tracking-tight"
				data-transition-name={`blog-title-${slug}`}
				transition:name={`blog-title-${slug}`}
			>
				{title}
			</h2>
			{description !== "" && <p class="text-xs opacity-75">{description}</p>}
		</div>
	</article>
</a>
