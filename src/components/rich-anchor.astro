---
import type { JSX } from "astro/jsx-runtime";
import type { HTMLAttributes } from "astro/types";

import IconArrowSquareOutFill from "~icons/ph/arrow-square-out-fill";

import Anchor from "~/components/anchor.astro";

export interface Props extends HTMLAttributes<"a"> {
	description?: string;
	href: string;
	icons?: { icon: JSX.Element; title: string }[];
	title: string;
}
const { description = "", href, icons = [], title, ...rest } = Astro.props;
---

<Anchor {...rest} href={href} target="_blank">
	<article>
		<div class="icons">
			<span class="sr-only">Project relates to:</span>
			{
				icons.length > 0 &&
					icons.map((icon) => (
						<span title={icon.title}>
							<icon.icon />
						</span>
					))
			}
		</div>

		<div class="link-info">
			<h2 class="title">{title}</h2>
			<h3 class="description">{description}</h3>
		</div>
	</article>
	<IconArrowSquareOutFill aria-hidden="true" />
</Anchor>

<style>
	article {
		display: flex;
		gap: 0.5rem;
		padding: 0.5rem;
		text-decoration: none;
	}

	.icons {
		display: flex;
		flex-shrink: 0;
		gap: 0.5rem;
	}

	.title {
		font-size: 1.125rem;
		margin-right: var(--size-2);
	}

	.description {
		max-width: 40ch;
		font-size: 0.75rem;
		font-weight: normal;
	}

	article :global(svg) {
		width: 2rem;
		height: 2rem;
	}

	.link-info {
		flex-grow: 1;
		display: flex;
		flex-direction: column;
		gap: var(--size-1);
	}

	a > svg {
		width: 1.05rem;
		height: 1.05rem;
		opacity: 0.75;
		position: absolute;
		top: 0;
		right: 0;
		margin: var(--size-2);
		pointer-events: none;
	}

	a:hover {
		& > svg {
			color: color-mix(in oklch, var(--color-link), black 25%);
		}
	}
</style>
