---
interface Props {
	crumbs: {
		href: string;
		icon?: JSX.Element;
		label: string;
	}[];
}
import type { JSX } from "astro/jsx-runtime";

import IconCaretRight from "~icons/ph/caret-right";

const { crumbs = [] } = Astro.props;
---

<nav aria-label="Breadcrumb navigation" transition:name="breadcrumb">
	<ol>
		{
			crumbs.map((crumb) => (
				<li>
					<a href={crumb.href}>
						{crumb.icon && <crumb.icon aria-hidden="true" />}
						{crumb.label}
					</a>
					{crumbs.at(-1) !== crumb && <IconCaretRight aria-hidden="true" />}
				</li>
			))
		}
	</ol>
</nav>

<style>
	nav {
		color: oklch(0 0 0 / 0.66);
		font-size: 0.875rem;
		overflow: hidden;

		a:hover {
			color: oklch(0 0 0 / 1);
			transition: all 0.1s ease-in-out;
		}
	}

	ol {
		display: flex;
		align-items: center;
		background: linear-gradient(
			to right,
			oklch(100% 0 0 / 0.66),
			oklch(100% 0 0 / 0.33)
		);
		border: 1px solid oklch(0 0 0 / 0.1);
		padding: 0.25rem 0.5rem;
		border-radius: 0.5rem;
		max-width: max-content;
	}

	li {
		max-width: 20ch;
		flex-shrink: 0;
		text-overflow: ellipsis;
		white-space: nowrap;
		overflow: hidden;
		margin-right: 0.125rem;

		@media screen and (max-width: 768px) {
			max-width: 100%;
		}

		&:last-child {
			flex-shrink: 1;
			margin-right: 0;
		}
	}
</style>
