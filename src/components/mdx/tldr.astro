---
import IconTimer from "~icons/ph/timer";
---

<section class="tldr">
	<IconTimer aria-hidden="true" />

	<div>
		<h2>TL;DR</h2>
		<slot />
	</div>
</section>

<style>
	.tldr {
		padding: 3rem;
		margin: 1.5rem -1rem !important;
		display: flex;
		align-items: flex-start;
		justify-content: flex-start;
		gap: 1rem;
		background: linear-gradient(
			135deg,
			oklch(100% 0 0 / 0.5),
			oklch(100% 0 0 / 0.05)
		);
		backdrop-filter: blur(10px) saturate(200%) hue-rotate(30deg);
		border: 1px solid oklch(80% 0 0 / 0.5);
		border-left: none;
		border-right: none;

		> svg {
			width: 3rem;
			height: 100%;
			opacity: 0.75;
		}

		p {
			max-width: 69ch;
		}
	}
</style>
