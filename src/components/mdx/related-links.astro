---
import IconArrowSquareOutFill from "~icons/ph/arrow-square-out-fill";
import IconLink from "~icons/ph/link";

interface Props {
	links: {
		description?: string;
		href: string;
		title: string;
	}[];
}

const { links } = Astro.props;
---

<aside aria-labelledby="related-links-heading" class="related-links">
	<h3 id="related-links-heading">
		<IconLink aria-hidden="true" /> Related Links
	</h3>
	<nav aria-label="Related articles">
		<ul>
			{
				links.map((link) => (
					<li>
						<a href={link.href} rel="noopener noreferrer" target="_blank">
							<IconArrowSquareOutFill aria-hidden="true" />
							<h4>{link.title}</h4>
							{link.description && <p>{link.description}</p>}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</aside>

<style>
	ul {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-sm);

		@media screen and (max-width: 768px) {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	li {
		display: grid;
	}

	h3 {
		font-size: 1rem;
		margin-bottom: var(--spacing-sm);
	}

	h4 {
		font-size: 0.875rem;
	}

	a {
		border: 1px solid oklch(80% 0 0 / 0.5);
		color: inherit;
		background: linear-gradient(
			135deg,
			oklch(100% 0 0 / 0.5),
			oklch(100% 0 0 / 0.05)
		);
		backdrop-filter: blur(10px) saturate(200%) hue-rotate(30deg);
		text-decoration: none;
		display: block;
		padding: var(--spacing-sm);
		border-radius: var(--spacing-xs);
		position: relative;

		& > h4 {
			color: var(--color-link);
			text-decoration: underline;
			margin-bottom: var(--spacing-xxs);
		}

		& > svg {
			width: 1rem;
			height: 1rem;
			opacity: 0.5;
			position: absolute;
			top: 0;
			right: 0;
			margin: var(--spacing-xs);
			pointer-events: none;
			color: var(--color-link);
		}
	}

	p {
		font-size: 0.75rem;
		max-width: 40ch;
	}
</style>
