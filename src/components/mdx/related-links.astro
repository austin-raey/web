---
import IconLink from "~icons/ph/link";

import RichAnchor from "../rich-anchor.astro";

interface Props {
	links: {
		description?: string;
		href: string;
		title: string;
	}[];
}

const { links } = Astro.props;
---

<aside aria-labelledby="related-links-heading" class="related-links">
	<h3 id="related-links-heading">
		<IconLink aria-hidden="true" /> Related Links
	</h3>
	<nav aria-label="Related articles">
		<ul>
			{
				links.map((link) => (
					<li>
						<RichAnchor
							description={link.description}
							href={link.href}
							title={link.title}
						/>
					</li>
				))
			}
		</ul>
	</nav>
</aside>

<style>
	aside {
		padding: var(--size-3) 0;
	}

	ul {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--size-3);

		@media screen and (max-width: 768px) {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	li {
		display: grid;
	}

	h3 {
		font-size: 1rem;
		margin-bottom: var(--size-3);
	}

	h4 {
		font-size: 0.875rem;
	}

	p {
		font-size: 0.75rem;
		max-width: 40ch;
	}
</style>
