---
const props = Astro.props;
// import IconArrowsOutSimple from "~icons/ph/arrows-out-simple";
import IconClipboardText from "~icons/ph/clipboard-text";
---

<code-block>
	<div class="controls">
		<button title="Copy code" type="button">
			<span class="sr-only">Copy code</span>
			<IconClipboardText aria-hidden="true" />
		</button>
		<!-- <button title="Expand code block" type="button">
			<span class="sr-only">Expand code block</span>
			<IconArrowsOutSimple aria-hidden="true" />
		</button> -->
	</div>
	<pre {...props}><slot /></pre>
</code-block>

<style>
	code-block {
		position: relative;
		max-width: max-content;
		display: block;
	}

	.controls {
		color: var(--color-text);
		position: absolute;
		display: flex;
		gap: 0.5rem;
		top: 0;
		right: 0;
		margin: var(--size-2);
		z-index: 10;

		& button {
			color: inherit;
			background: linear-gradient(to bottom right, #ffffff, #f0f0f0a0);
			padding: var(--size-1);
			border: 1px solid color-mix(in oklch, var(--color-text) 20%, transparent);
			border-radius: var(--size-2);
			transition: background 0.2s ease-in-out;

			&:hover {
				background: linear-gradient(to bottom right, #f0f0f0, #e0e0e0);
			}
		}
	}

	pre {
		background: var(--glass-surface-strong) !important;
		backdrop-filter: var(--glass-filter);
		border: 1px solid oklch(0 0 0 / 0.1);
		border-radius: 0.5rem;
		padding: 0.5rem;
		padding-right: 2rem;
		scrollbar-color: #0004 transparent;
		scrollbar-width: thin;
		max-width: max-content;
		max-height: 30ch;

		span {
			text-shadow: none;
		}
	}
</style>

<script>
	class CodeBlock extends HTMLElement {
		#controls = this.querySelector(".controls");
		#pre = this.querySelector("pre");

		connectedCallback() {
			const copyButton = this.#controls?.firstElementChild;
			// const expandButton = this.#controls?.lastElementChild;

			copyButton?.addEventListener("click", this.#copy);
			// expandButton?.addEventListener("click", this.#expand);
		}

		#copy = () => {
			const code = this.#pre?.textContent;
			if (code) {
				navigator.clipboard.writeText(code);
			}
		};

		// #expand = () => {
		// 	console.log("expanding", this.#pre);
		// 	this.#pre?.classList.toggle("expanded");
		// };
	}

	customElements.define("code-block", CodeBlock);
</script>
