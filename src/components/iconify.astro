---
export interface IconProperties {
	name: string;
	title?: string;
}

interface Props extends IconProperties {
	class?: string;
}

const { class: className, name, title } = Astro.props;
const isLogo = name.startsWith("logos--");
---

<span
	aria-hidden={title ? undefined : "true"}
	class:list={[
		{
			iconify: !isLogo,
			"iconify-color": isLogo
		},
		name,
		!title && "pointer-events-none",
		className
	]}
	title={title}
>
</span>
