---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
	prefetch?: boolean;
	priority?: "high" | "low";
}

const { prefetch = true, priority = "low", ...rest } = Astro.props;

let prefetchValue = "false";
if (prefetch) {
	prefetchValue = priority === "high" ? "viewport" : "hover";
}
---

<a data-astro-prefetch={prefetchValue} {...rest}>
	<slot />
</a>

<style>
	a > :global(svg) {
		margin-right: 0.125em;
	}

	a {
		border-radius: var(--size-3);
		display: block;
		font-weight: 600;
		padding: var(--size-1) var(--size-2);

		background: linear-gradient(
			135deg,
			oklch(100% 0 0 / 0.5),
			oklch(100% 0 0 / 0.05)
		);
		backdrop-filter: blur(10px) saturate(200%) hue-rotate(30deg);
		border: 1px solid oklch(0 0 0 / 0.125);

		transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		transform: translateY(0) scale(1);
		text-decoration: none;

		color: var(--color-text);
	}

	a:hover,
	a:focus-within {
		background: linear-gradient(
			-135deg,
			oklch(100% 0 0 / 0.75),
			oklch(100% 0 0 / 0.25)
		);
		border-color: color-mix(in oklch, var(--color-link), black 20%);
		box-shadow: 0 4px 8px
			color-mix(in oklch, var(--color-link), transparent 90%);
		transform: translateY(-2.5px) scale(1.02);
		color: var(--color-link);
	}

	a:active {
		transform: translateY(2.5px) scale(0.98);
		box-shadow: 0 8px 16px oklch(0 0 0 / 0.1);
	}
</style>
