---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
	prefetch?: boolean;
	priority?: "high" | "low";
}

const { prefetch = true, priority = "low", ...rest } = Astro.props;

let prefetchValue = "false";
if (prefetch) {
	prefetchValue = priority === "high" ? "viewport" : "hover";
}

const attributes: Props = {
	"data-astro-prefetch": prefetchValue,
	...rest
};
---

<a data-astro-prefetch={attributes["data-astro-prefetch"]} {...rest}>
	<slot />
</a>

<style>
	a > :global(svg) {
		margin-right: 0.125em;
	}

	a {
		color: oklch(0.25 0.02 240);
		border-radius: 0.75rem;
		position: relative;
		overflow: hidden;
		font-weight: 600;
		padding: 0.25rem 0.5rem;

		/* Glassomorphic background */
		background: linear-gradient(
			135deg,
			oklch(100% 0 0 / 0.75),
			oklch(100% 0 0 / 0.25)
		);
		backdrop-filter: blur(10px) hue-rotate(-10deg) saturate(150%) opacity(10%);
		border: 1px solid oklch(0 0 0 / 0.125);

		transition: all 0.1s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	a:hover {
		background: linear-gradient(
			-135deg,
			oklch(100% 0 0 / 0.75),
			oklch(100% 0 0 / 0.25)
		);
		border-color: oklch(0 0 0 / 0.4);
		box-shadow: 0 8px 16px oklch(0 0 0 / 0.15);
		transform: translateY(-2px);
	}

	a:active {
		transform: translateY(0);
		box-shadow: 0 8px 16px oklch(0 0 0 / 0.1);
	}
</style>
